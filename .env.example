# Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=from-meta-app-dashboard
WHATSAPP_ACCESS_TOKEN=system-user-permanent-token
WHATSAPP_PHONE_NUMBER_ID=from-whatsapp-api-setup
# Check Meta's docs for the current Graph API version
WHATSAPP_API_VERSION=v21.0

# Back office: signs staff session cookies. At least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
